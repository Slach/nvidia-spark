ARG UBUNTU_VERSION=24.04
ARG CUDA_VERSION=13.3.1
ARG BASE_CUDA_DEV_CONTAINER=nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION}
ARG BASE_CUDA_RUN_CONTAINER=nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION}

FROM ${BASE_CUDA_DEV_CONTAINER} AS build

RUN apt-get update && apt-get install -y \
    python3-pip python3.12-dev python3.12-venv pipx \
    build-essential ninja-build cmake git curl bash ccache \
    && rm -rf /var/lib/apt/lists/*

SHELL ["/bin/bash", "-c"]
ENV PATH="/root/.local/bin:${PATH}"
RUN pipx install uv

# only requirements first: deps + cubins + AOT layers stay cached across vllm source edits
COPY requirements/ /vllm/requirements/
WORKDIR /vllm/

ENV CUDA_HOME=/usr/local/cuda-13.3 \
    TORCH_CUDA_ARCH_LIST="12.1a" \
    FLASHINFER_CUDA_ARCH_LIST="12.1a" \
    FLASHINFER_CUBIN_DOWNLOAD_THREADS=10 \
    FLASHINFER_LOGGING_LEVEL=WARNING \
    VLLM_TARGET_DEVICE=cuda \
    VLLM_CUDA_VERSION="13.3" \
    UV_CONCURRENT_DOWNLOADS=3 \
    UV_HTTP_RETRIES=10

RUN --mount=type=cache,target=/root/.cache/ \
    uv venv --python python3.12 && \
    source ./.venv/bin/activate && \
    uv pip install -r requirements/build/cuda.txt -r requirements/cuda.txt --torch-backend cu130 && \
    uv pip install fastsafetensors runai-model-streamer

RUN --mount=type=cache,target=/root/.cache/ \
    source ./.venv/bin/activate && \
    export MAX_JOBS=$(nproc) && \
    /vllm/.venv/bin/python3.12 -m flashinfer.aot && \
    HTTP_PROXY=http://192.168.3.3:9998 /vllm/.venv/bin/python3.12 -m flashinfer --download-cubin || true

# source edits invalidate only from here down; ccache (cache mount) makes recompile fast
COPY ./ /vllm/

RUN --mount=type=cache,target=/root/.cache/ \
    source ./.venv/bin/activate && \
    export MAX_JOBS=$(nproc) CCACHE_DIR=/root/.cache/ccache CCACHE_COMPILERCHECK=content && \
    export CMAKE_ARGS="-DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache -DCMAKE_CUDA_COMPILER_LAUNCHER=ccache" && \
    uv pip install . --no-build-isolation -v

FROM ${BASE_CUDA_RUN_CONTAINER} AS runtime

RUN apt update && \
    apt install -y python3.12 python3.12-venv python3.12-dev gcc g++ ninja-build curl && \
    apt install -y cuda-nvcc-13-3 cuda-libraries-dev-13-3 && \
    rm -rf /var/lib/apt/lists/*
    
COPY --from=build /vllm/.venv /vllm/.venv
ENV PATH="/vllm/.venv/bin:${PATH}"
ENV VLLM_USAGE_SOURCE=docker
# for properly fastsafetensors initialization
# RUN ln -s /usr/local/cuda/lib64/libcudart.so.13 /usr/local/cuda/lib64/libcudart.so    
